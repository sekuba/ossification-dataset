{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code-age incident revalidation queue",
  "type": "object",
  "required": ["$schema", "schemaVersion", "input", "counts", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../schema/revalidation.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "input": {
      "type": "object",
      "required": ["incidentsSha256", "incidents", "targets"],
      "additionalProperties": false,
      "properties": {
        "incidentsSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "incidents": { "type": "integer", "minimum": 0 },
        "targets": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": {
      "type": "object",
      "required": ["ready", "blocked", "byBlocker"],
      "additionalProperties": false,
      "properties": {
        "ready": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "byBlocker": { "$ref": "#/$defs/blockerCounts" }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "blocker": {
      "enum": [
        "incident-anchor",
        "root-cause",
        "loss",
        "target-relationship",
        "artifact-code-hash",
        "deployment-anchor",
        "code-change",
        "failure-mode",
        "target-evidence",
        "mechanical-verification",
        "semantic-review"
      ]
    },
    "blockerCounts": {
      "type": "object",
      "required": [
        "incident-anchor",
        "root-cause",
        "loss",
        "target-relationship",
        "artifact-code-hash",
        "deployment-anchor",
        "code-change",
        "failure-mode",
        "target-evidence",
        "mechanical-verification",
        "semantic-review"
      ],
      "additionalProperties": false,
      "properties": {
        "incident-anchor": { "type": "integer", "minimum": 0 },
        "root-cause": { "type": "integer", "minimum": 0 },
        "loss": { "type": "integer", "minimum": 0 },
        "target-relationship": { "type": "integer", "minimum": 0 },
        "artifact-code-hash": { "type": "integer", "minimum": 0 },
        "deployment-anchor": { "type": "integer", "minimum": 0 },
        "code-change": { "type": "integer", "minimum": 0 },
        "failure-mode": { "type": "integer", "minimum": 0 },
        "target-evidence": { "type": "integer", "minimum": 0 },
        "mechanical-verification": { "type": "integer", "minimum": 0 },
        "semantic-review": { "type": "integer", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "required": ["incidentId", "targetId", "blockers"],
      "additionalProperties": false,
      "properties": {
        "incidentId": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-f]{64}$"
        },
        "targetId": { "type": "string", "pattern": "^target-[1-9][0-9]*$" },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/blocker" }
        }
      }
    }
  }
}
