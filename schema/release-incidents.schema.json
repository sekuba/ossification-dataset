{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2beat.com/schemas/ossification-dataset/release-incidents.schema.json",
  "title": "Ossification incident release",
  "description": "Reviewed incidents only: the summary and loss a curve observation joins to through id. Targets are projected into curve.json; full records, evidence, verification and the unreviewed backlog live in incidents/ and are hashed in the manifest.",
  "type": "object",
  "required": ["$schema", "formatVersion", "schemaVersion", "incidents"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../../schema/release-incidents.schema.json" },
    "formatVersion": { "const": 1 },
    "schemaVersion": { "const": "2.0.0" },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "protocol", "name", "chainId", "exploit", "summary", "loss"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "incident.schema.json#/properties/id" },
          "protocol": { "$ref": "incident.schema.json#/$defs/protocol" },
          "name": { "type": "string", "minLength": 1 },
          "chainId": { "type": "integer", "minimum": 1 },
          "exploit": { "$ref": "incident.schema.json#/$defs/incident/properties/exploit" },
          "summary": { "type": "string", "minLength": 1 },
          "loss": { "$ref": "incident.schema.json#/$defs/loss" }
        }
      }
    }
  }
}
