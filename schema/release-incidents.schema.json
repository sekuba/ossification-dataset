{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2beat.com/schemas/ossification-dataset/release-incidents.schema.json",
  "title": "Ossification incident release",
  "description": "One row per reviewed incident with a knot: summary, loss, and the age of the failed code. Excluded records list the reasons they contribute nothing. Full evidence lives in incidents/ and is hashed in the manifest.",
  "type": "object",
  "required": ["$schema", "formatVersion", "description", "incidents", "excluded"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../../schema/release-incidents.schema.json" },
    "formatVersion": { "const": 2 },
    "description": { "type": "string", "minLength": 1 },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "protocol", "name", "chainId", "exploit", "summary", "loss",
          "targetId", "failureModeId", "codeHash", "ageResetKind", "codeAgeSeconds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-f]{64}$" },
          "protocol": { "$ref": "incident.schema.json#/$defs/protocol" },
          "name": { "type": "string", "minLength": 1 },
          "chainId": { "type": "integer", "minimum": 1 },
          "exploit": {
            "type": "object",
            "required": ["transactionHash", "blockNumber", "transactionIndex", "timestamp"],
            "additionalProperties": false,
            "properties": {
              "transactionHash": { "$ref": "incident.schema.json#/$defs/hash" },
              "blockNumber": { "type": "integer", "minimum": 0 },
              "transactionIndex": { "type": "integer", "minimum": 0 },
              "timestamp": { "type": "integer", "minimum": 1 }
            }
          },
          "summary": { "type": "string", "minLength": 1 },
          "loss": { "$ref": "incident.schema.json#/$defs/loss" },
          "targetId": { "type": "string", "pattern": "^target-[1-9][0-9]*$" },
          "failureModeId": { "type": "string", "pattern": "^failure:[a-z0-9]+(?:[-:][a-z0-9]+)*$" },
          "codeHash": { "$ref": "incident.schema.json#/$defs/hash" },
          "ageResetKind": { "enum": ["deployment", "implementation-change", "module-change", "configuration-change"] },
          "codeAgeSeconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "chainId", "verificationTier", "exclusionReasons"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-f]{64}$" },
          "name": { "type": "string", "minLength": 1 },
          "chainId": { "type": "integer", "minimum": 1 },
          "verificationTier": { "enum": ["provisional", "reviewed"] },
          "exclusionReasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
