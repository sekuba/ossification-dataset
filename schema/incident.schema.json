{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onchain exploited-code-age incident",
  "description": "One measured EVM code-bug incident with exploit-time code age and loss evidence.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "protocol",
    "name",
    "incident",
    "classification",
    "loss",
    "targets",
    "sources",
    "verification",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../../schema/incident.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "id": {
      "type": "string",
      "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-f]{64}$",
      "description": "Stable incident identity: eip155:<chainId>:<selected incident transaction hash>."
    },
    "protocol": { "$ref": "#/$defs/protocol" },
    "name": { "type": "string", "minLength": 1 },
    "incident": { "$ref": "#/$defs/incident" },
    "classification": { "$ref": "#/$defs/classification" },
    "loss": { "$ref": "#/$defs/loss" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "discovery": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:dfhl|legacy|web):[^\\s]+$"
      },
      "description": "Research-ledger candidate ids this incident resolves. Declares the discovery lead a record answers so research/candidates.json can mark it covered; carries no evidentiary weight."
    },
    "verification": { "$ref": "#/$defs/incidentVerification" },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Incident-level caveats not represented by a more specific field. Legacy prose is retained verbatim here when needed."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "tier": { "const": "reviewed" } },
            "required": ["tier"]
          }
        }
      },
      "then": {
        "properties": {
          "incident": {
            "properties": {
              "exploit": { "$ref": "#/$defs/completeExploitAnchor" }
            }
          },
          "loss": { "$ref": "#/$defs/reviewedLoss" },
          "verification": {
            "required": ["reviewSourceIds"],
            "properties": {
              "reviewSourceIds": { "$ref": "#/$defs/reviewSourceIds" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "tier": { "const": "provisional" } },
            "required": ["tier"]
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "items": {
              "properties": {
                "verification": {
                  "properties": { "curveEligible": { "const": false } }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^source-[1-9][0-9]*$"
    },
    "nullableAddress": {
      "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }]
    },
    "nullableHash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "protocol": {
      "type": "object",
      "required": ["name", "slug"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "incident": {
      "type": "object",
      "required": ["chainId", "exploit", "attackerAddresses"],
      "additionalProperties": false,
      "properties": {
        "chainId": { "type": "integer", "minimum": 1 },
        "exploit": {
          "type": "object",
          "required": ["transactionHash", "blockNumber", "transactionIndex", "timestamp"],
          "additionalProperties": false,
          "properties": {
            "transactionHash": { "$ref": "#/$defs/hash" },
            "blockNumber": { "type": ["integer", "null"], "minimum": 0 },
            "transactionIndex": { "type": ["integer", "null"], "minimum": 0 },
            "timestamp": { "type": "integer", "minimum": 1 }
          }
        },
        "attackerAddresses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/address" }
        }
      }
    },
    "classification": {
      "type": "object",
      "required": ["rootCause", "summary"],
      "additionalProperties": false,
      "properties": {
        "rootCause": { "const": "code-bug" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "loss": {
      "type": "object",
      "required": ["kind", "usd", "minimumUsd", "assets", "confidence", "notes"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["gross-assets-lost", "net-loss", "permanently-locked", "legacy-unspecified"]
        },
        "usd": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["amount", "valuationTimestamp", "method", "sourceIds"],
              "additionalProperties": false,
              "properties": {
                "amount": { "type": "number", "minimum": 1000 },
                "valuationTimestamp": { "type": "integer", "minimum": 1 },
                "method": {
                  "enum": ["incident-price", "stablecoin-par", "reported", "legacy-unspecified", "other"]
                },
                "sourceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "minimumUsd": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["amount", "basis", "sourceIds"],
              "additionalProperties": false,
              "properties": {
                "amount": { "type": "number", "minimum": 1000 },
                "basis": { "enum": ["asset-valuation", "reported-lower-bound", "other"] },
                "sourceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ],
          "description": "Explicit lower bound used to establish inclusion when an exact USD valuation is unavailable."
        },
        "assets": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/assetComponent" },
              { "$ref": "#/$defs/legacyAssetDescription" }
            ]
          }
        },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "notes": { "type": "string", "minLength": 1 },
        "realizedAt": {
          "type": "integer",
          "minimum": 1,
          "description": "Timestamp at which the campaign's loss was realised, when that is later than the incident anchor. Bounds how late a contemporaneous valuation may be; must not precede incident.exploit.timestamp."
        }
      },
      "anyOf": [
        { "properties": { "usd": { "type": "object" } } },
        {
          "properties": {
            "minimumUsd": { "type": "object" },
            "assets": { "minItems": 1 }
          }
        }
      ]
    },
    "reviewedLoss": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["gross-assets-lost", "net-loss", "permanently-locked"] },
        "usd": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "method": { "enum": ["incident-price", "stablecoin-par", "reported", "other"] },
                "sourceIds": { "minItems": 1 }
              }
            }
          ]
        },
        "minimumUsd": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "basis": { "enum": ["asset-valuation", "reported-lower-bound", "other"] },
                "sourceIds": { "minItems": 1 }
              }
            }
          ]
        },
        "assets": {
          "items": { "$ref": "#/$defs/assetComponent" }
        },
        "confidence": { "enum": ["high", "medium"] }
      }
    },
    "assetComponent": {
      "type": "object",
      "required": ["asset", "amount", "usdValue", "valuation", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "object",
          "required": ["chainId", "tokenAddress", "symbol"],
          "additionalProperties": false,
          "properties": {
            "chainId": { "type": ["integer", "null"], "minimum": 1 },
            "tokenAddress": { "$ref": "#/$defs/nullableAddress" },
            "symbol": { "type": ["string", "null"], "minLength": 1 }
          },
          "anyOf": [
            { "properties": { "tokenAddress": { "$ref": "#/$defs/address" } } },
            { "properties": { "symbol": { "type": "string" } } }
          ]
        },
        "amount": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
          ]
        },
        "usdValue": { "type": ["number", "null"], "minimum": 0 },
        "valuation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["method", "timestamp", "unitPriceUsd", "sourceIds"],
              "additionalProperties": false,
              "properties": {
                "method": { "enum": ["incident-price", "stablecoin-par", "reported", "other"] },
                "timestamp": { "type": "integer", "minimum": 1 },
                "unitPriceUsd": { "type": ["number", "null"], "minimum": 0 },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/sourceId" }
                }
              }
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "legacyAssetDescription": {
      "description": "Migration-only unparsed asset prose; reviewed incidents must use assetComponent.",
      "type": "object",
      "required": ["description", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "completeExploitAnchor": {
      "type": "object",
      "required": ["transactionHash", "blockNumber", "transactionIndex", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "transactionHash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "transactionIndex": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "integer", "minimum": 1 }
      }
    },
    "deploymentAnchor": {
      "type": "object",
      "required": ["timestamp", "blockNumber", "transactionHash", "transactionIndex", "creatorAddress"],
      "additionalProperties": false,
      "properties": {
        "timestamp": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": ["integer", "null"], "minimum": 0 },
        "transactionHash": { "$ref": "#/$defs/nullableHash" },
        "transactionIndex": { "type": ["integer", "null"], "minimum": 0 },
        "creatorAddress": { "$ref": "#/$defs/nullableAddress" }
      }
    },
    "changeAnchor": {
      "type": "object",
      "required": ["kind", "timestamp", "blockNumber", "transactionHash", "transactionIndex", "logIndex", "mechanism", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["deployment", "implementation-change", "module-change", "configuration-change", "unknown"]
        },
        "timestamp": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": ["integer", "null"], "minimum": 0 },
        "transactionHash": { "$ref": "#/$defs/nullableHash" },
        "transactionIndex": { "type": ["integer", "null"], "minimum": 0 },
        "logIndex": { "type": ["integer", "null"], "minimum": 0 },
        "mechanism": { "$ref": "#/$defs/changeMechanism" },
        "description": { "type": ["string", "null"] }
      }
    },
    "completeAnchor": {
      "type": "object",
      "required": ["timestamp", "blockNumber", "transactionHash", "transactionIndex", "creatorAddress"],
      "additionalProperties": false,
      "properties": {
        "timestamp": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "transactionHash": { "$ref": "#/$defs/hash" },
        "transactionIndex": { "type": "integer", "minimum": 0 },
        "creatorAddress": { "$ref": "#/$defs/address" }
      }
    },
    "completeChangeAnchor": {
      "type": "object",
      "required": ["kind", "timestamp", "blockNumber", "transactionHash", "transactionIndex", "logIndex", "mechanism", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["deployment", "implementation-change", "module-change", "configuration-change", "unknown"]
        },
        "timestamp": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "transactionHash": { "$ref": "#/$defs/hash" },
        "transactionIndex": { "type": "integer", "minimum": 0 },
        "logIndex": { "type": ["integer", "null"], "minimum": 0 },
        "mechanism": { "$ref": "#/$defs/changeMechanism" },
        "description": { "type": ["string", "null"] }
      }
    },
    "changeMechanism": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "address"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "deployment" },
            "address": { "$ref": "#/$defs/address" }
          }
        },
        {
          "type": "object",
          "required": ["type", "address", "eventTopic", "codeAddressLocation"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "event" },
            "address": { "$ref": "#/$defs/address" },
            "eventTopic": { "$ref": "#/$defs/hash" },
            "codeAddressLocation": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^(topic[1-3]|data-word-(0|[1-9][0-9]*))-address$" }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "address", "storageSlot", "valueBefore", "valueAfter"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "storage-write" },
            "address": { "$ref": "#/$defs/address" },
            "storageSlot": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
            "valueBefore": { "type": "string", "pattern": "^0x[0-9a-f]*$" },
            "valueAfter": { "type": "string", "pattern": "^0x[0-9a-f]*$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "address"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "metamorphic-redeployment" },
            "address": { "$ref": "#/$defs/address" }
          }
        },
        {
          "type": "object",
          "required": ["type", "address"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "configuration" },
            "address": { "$ref": "#/$defs/nullableAddress" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["legacy-documented", "unknown"] }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "executionAddress",
        "relationship",
        "codeArtifact",
        "deployment",
        "lastCodeChange",
        "codeAgeSeconds",
        "failureModeId",
        "evidence",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^target-[1-9][0-9]*$" },
        "executionAddress": { "$ref": "#/$defs/address" },
        "relationship": {
          "enum": ["direct", "proxy", "beacon-proxy", "minimal-proxy", "diamond", "module-router", "library", "unknown"]
        },
        "codeArtifact": {
          "type": "object",
          "required": ["address", "codeHash"],
          "additionalProperties": false,
          "properties": {
            "address": { "$ref": "#/$defs/nullableAddress" },
            "codeHash": { "$ref": "#/$defs/nullableHash" }
          }
        },
        "deployment": { "$ref": "#/$defs/deploymentAnchor" },
        "lastCodeChange": { "$ref": "#/$defs/changeAnchor" },
        "codeAgeSeconds": { "type": "integer", "minimum": 0 },
        "failureModeId": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/targetEvidence" },
        "verification": { "$ref": "#/$defs/targetVerification" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "properties": { "tier": { "enum": ["mechanical", "reviewed"] } },
                "required": ["tier"]
              }
            }
          },
          "then": {
            "properties": {
              "deployment": { "$ref": "#/$defs/completeAnchor" },
              "lastCodeChange": { "$ref": "#/$defs/completeChangeAnchor" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": { "tier": { "const": "reviewed" } },
                "required": ["tier"]
              }
            }
          },
          "then": {
            "properties": {
              "codeArtifact": {
                "properties": {
                  "address": { "$ref": "#/$defs/address" },
                  "codeHash": { "$ref": "#/$defs/hash" }
                }
              },
              "relationship": {
                "enum": ["direct", "proxy", "beacon-proxy", "minimal-proxy", "diamond", "module-router", "library"]
              },
              "failureModeId": {
                "pattern": "^failure:[a-z0-9]+(?:[-:][a-z0-9]+)*$"
              },
              "evidence": {
                "properties": {
                  "identitySourceIds": { "minItems": 1 },
                  "codeHistorySourceIds": { "minItems": 1 }
                }
              },
              "verification": {
                "required": ["reviewSourceIds"],
                "properties": {
                  "reviewSourceIds": { "$ref": "#/$defs/reviewSourceIds" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": { "curveEligible": { "const": true } },
                "required": ["curveEligible"]
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "properties": { "tier": { "const": "reviewed" } }
              },
              "lastCodeChange": {
                "properties": {
                  "kind": { "enum": ["deployment", "implementation-change", "module-change"] },
                  "mechanism": {
                    "properties": {
                      "type": { "enum": ["deployment", "event", "storage-write", "metamorphic-redeployment"] },
                      "address": { "$ref": "#/$defs/address" }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "type": { "const": "event" } }, "required": ["type"] },
                        "then": {
                          "properties": {
                            "codeAddressLocation": {
                              "type": "string",
                              "pattern": "^(topic[1-3]|data-word-(0|[1-9][0-9]*))-address$"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": { "tier": { "enum": ["provisional", "mechanical"] } },
                "required": ["tier"]
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "properties": { "curveEligible": { "const": false } }
              }
            }
          }
        }
      ]
    },
    "targetEvidence": {
      "type": "object",
      "required": ["identitySourceIds", "codeHistorySourceIds"],
      "additionalProperties": false,
      "properties": {
        "identitySourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        },
        "codeHistorySourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "targetVerification": {
      "type": "object",
      "required": ["tier", "curveEligible", "limitations"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": ["provisional", "mechanical", "reviewed"],
          "description": "provisional = incomplete target/code research; mechanical = anchors reproduced by a limited strategy; reviewed = target identity and complete code history reviewed."
        },
        "curveEligible": { "type": "boolean" },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewSourceIds": { "$ref": "#/$defs/reviewSourceIds" }
      }
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/onchainSource" },
        { "$ref": "#/$defs/onchainTransactionSetSource" },
        { "$ref": "#/$defs/postMortemSource" },
        { "$ref": "#/$defs/priceDataSource" },
        { "$ref": "#/$defs/sourceCodeSource" },
        { "$ref": "#/$defs/reviewNoteSource" }
      ]
    },
    "onchainSource": {
      "type": "object",
      "required": ["id", "type", "supports", "chainId", "transactionHash"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^source-[1-9][0-9]*$" },
        "type": { "const": "onchain-transaction" },
        "supports": { "$ref": "#/$defs/supports" },
        "chainId": { "type": "integer", "minimum": 1 },
        "transactionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "onchainTransactionSetSource": {
      "type": "object",
      "required": ["id", "type", "supports", "chainId", "transactionHashes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^source-[1-9][0-9]*$" },
        "type": { "const": "onchain-transaction-set" },
        "supports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "loss" }
        },
        "chainId": { "type": "integer", "minimum": 1 },
        "transactionHashes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "postMortemSource": {
      "type": "object",
      "required": ["id", "type", "supports", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^source-[1-9][0-9]*$" },
        "type": { "const": "post-mortem" },
        "supports": { "$ref": "#/$defs/supports" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "priceDataSource": {
      "type": "object",
      "required": ["id", "type", "supports", "provider", "url", "observedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "type": { "const": "price-data" },
        "supports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "loss" }
        },
        "provider": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "observedAt": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceCodeSource": {
      "type": "object",
      "required": ["id", "type", "supports", "repository", "commit", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^source-[1-9][0-9]*$" },
        "type": { "const": "source-code" },
        "supports": { "$ref": "#/$defs/supports" },
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "reviewNoteSource": {
      "type": "object",
      "required": ["id", "type", "supports", "note"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^source-[1-9][0-9]*$" },
        "type": { "const": "review-note" },
        "supports": { "$ref": "#/$defs/supports" },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "reviewSourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceId" }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["incident-anchor", "target-identity", "code-history", "root-cause", "loss"]
      }
    },
    "incidentVerification": {
      "type": "object",
      "required": ["tier", "limitations"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": ["provisional", "reviewed"],
          "description": "provisional = incident classification or loss evidence needs review; reviewed = exploit anchor, root cause, and loss evidence reviewed."
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewSourceIds": { "$ref": "#/$defs/reviewSourceIds" },
        "legacy": {
          "type": "object",
          "required": ["snapshot", "originalFile", "originalIncidentIndex", "status", "basis", "upgradeEventCount", "date"],
          "additionalProperties": false,
          "properties": {
            "snapshot": { "const": "research/raw/legacy-v1.json" },
            "originalFile": { "type": "string", "pattern": "^protocols/[a-z0-9-]+\\.json$" },
            "originalIncidentIndex": { "type": "integer", "minimum": 0 },
            "status": { "const": "OK" },
            "basis": { "enum": ["deployment", "upgrade-events", "documented"] },
            "upgradeEventCount": { "type": "integer", "minimum": 0 },
            "date": { "type": "string", "format": "date-time" },
            "reanchored": {
              "const": true,
              "description": "Set when review moved the incident anchor off the snapshot row's exploit transaction. Required exactly when the two differ."
            }
          }
        }
      }
    }
  }
}
